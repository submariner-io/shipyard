ARG FEDORA_VERSION=44

FROM --platform=${BUILDPLATFORM} fedora:${FEDORA_VERSION} AS base
ARG VERSION
ARG FEDORA_VERSION
ARG TARGETPLATFORM

COPY scripts/shared/dnf_install /

RUN /dnf_install -a ${TARGETPLATFORM} -v ${FEDORA_VERSION} -r /output/nettest \
    bash coreutils-single libcurl-minimal \
    bind-utils busybox-shared curl iperf3 iproute iputils netperf nmap-ncat tcpdump

RUN ln /output/nettest/usr/bin/busybox.shared /output/nettest/usr/bin/busybox

FROM scratch
ARG TARGETPLATFORM
ARG VERSION
ENV PATH="/app:$PATH"

WORKDIR /app

COPY --from=base /output/nettest /

COPY scripts/nettest/* /app/

RUN echo ${VERSION} >> /app/version

USER 10000

CMD ["/bin/bash","-l"]
