FROM fedora:44

# Unless specified otherwise, compress to a medium level which gives (from experimentation) a
# good balance between compression time and resulting image size.
ARG UPX_LEVEL=-5
ENV DAPPER_HOST_ARCH=amd64 SHIPYARD_DIR=/opt/shipyard SHELL=/bin/bash \
    DAPPER_RUN_ARGS="--net=kind"
ENV HOST_ARCH=${DAPPER_HOST_ARCH} ARCH=${DAPPER_HOST_ARCH} PATH=/go/bin:/root/.local/bin:/usr/local/go/bin:$PATH \
    GOLANG_ARCH_amd64=amd64 GOLANG_ARCH_arm=armv6l GOLANG_ARCH=GOLANG_ARCH_${DAPPER_HOST_ARCH} \
    GOPATH=/go GO111MODULE=on GOPROXY=https://proxy.golang.org \
    SCRIPTS_DIR=${SHIPYARD_DIR}/scripts

# Requirements:
# Component          | Usage
# -------------------------------------------------------------
# curl               | download other tools
# docker-buildx      | multi-arch image construction
# file               | file identification (in compile/test.sh)
# findutils          | make unit (find unit test dirs)
# gcc                | needed by `go test -race` (https://github.com/golang/go/issues/27089)
# gh                 | backport, releases
# git-core           | find the workspace root, git clones
# golang             | build
# helm3              | Helm package construction
# jq                 | JSON processing (GitHub API)
# kubernetes-client  | kubectl, used in e2e tests
# make               | builds
# moby-engine        | Docker (for Dapper)
# moreutils          | sponge (for system tests)
# pip                | Python package installation
# pipx               | install jinjanator (required by OVN-K latest versions)
# procps-ng          | watch (for installing ACM)
# protobuf-compiler  | protobuf compilation
# python3-jinja2-cli | Jinja2 template engine (used by OVN's kind setup script)
# qemu-user-static-* | Emulation (for multiarch builds)
# skopeo             | container image manipulation
# unzip              | ZIP extraction
# upx                | binary compression
# yq                 | YAML processing (OCM deploy tool)

# This layer's versioning is handled by dnf, and isn't expected to be rebuilt much except in CI
# Removals and UPX are done after all installations, since image layers are diffs.
# /go and its subdirectories are created here so that /go can serve as
# reference point to find files installed in this layer.
# We remove:
# - DNF cache
# - Any unnecessary packages and executables
RUN mkdir -p /go/bin /go/pkg /go/src && \
    dnf -y install --nodocs --setopt=install_weak_deps=False \
                   curl \
                   docker-buildx \
                   file \
                   findutils \
                   gcc \
                   gh \
                   git-core \
                   gitlint \
                   golang \
                   helm3 \
                   jq \
                   kubernetes-client \
                   make \
                   moby-engine \
                   moreutils \
                   openssl \
                   pip \
                   pipx \
                   procps-ng \
                   protobuf-compiler \
                   python3-jinja2-cli \
                   qemu-user-static-aarch64 qemu-user-static-x86 \
                   skopeo \
                   unzip \
                   upx \
                   yq && \
    pipx install jinjanator[yaml] && \
    rpm -e --nodeps containerd && \
    rpm -qa "selinux*" | xargs -r rpm -e --nodeps && \
    dnf -y clean all && \
    rm -f /usr/bin/{dockerd,lto-dump} \
          /usr/libexec/gcc/x86_64-redhat-linux/*/lto1 && \
    if test ${UPX_LEVEL} != -0; then find /usr/bin /usr/lib/golang /usr/libexec -type f -executable -newercm /go -size +1M ! -name hyperkube \( -execdir upx ${UPX_LEVEL} {} \; -o -true \); fi && \
    ln -f /usr/bin/kubectl /usr/bin/hyperkube && \
    ln -f /usr/bin/helm3 /usr/bin/helm

COPY tools /tools

# This layer's versioning is determined by us,
# and thus could be rebuilt more frequently to test different versions.
# golangci-lint must be built with a version of Go equal to or newer
# than the version used to analyse the code, so this rebuilds it.
RUN go -C /tools install github.com/golangci/golangci-lint/v2/cmd/golangci-lint && \
    go -C /tools install sigs.k8s.io/kind && \
    go -C /tools install golang.org/x/vuln/cmd/govulncheck && \
    curl -L https://raw.githubusercontent.com/jonmosco/kube-ps1/1b8fe913b25ba857b84a94c3b1dbf7bb34f7caef/kube-ps1.sh -o /etc/profile.d/kube-ps1.sh && \
    find /go/bin -type f -executable -newercm /go -exec strip {} + && \
    if test ${UPX_LEVEL} != -0; then find /go/bin -type f -executable -newercm /go ! -name govulncheck \( -execdir upx ${UPX_LEVEL} {} \; -o -true \); fi && \
    go clean -cache -modcache && rm -rf /tools

# cosign for signing released community images (not packaged in Fedora dnf).
# Verified via sigstore's documented artifact-key process
# (https://docs.sigstore.dev/cosign/system_config/installation/#verifying-cosign-releases)
# instead of a checksum fetched from the same GitHub release as the binary: that checksum
# would only catch accidental truncation, not deliberate tampering, since an attacker who
# could alter the binary could alter the checksum file too. The TUF root file is pinned by
# hash (it's an immutable entry under root_history/, not a moving target) so this doesn't
# just shift trust to another unpinned GitHub fetch; verify-blob --bundle below completes
# the documented process by checking the bundle's Rekor log-inclusion proof, not just the
# raw artifact-key signature. tuf-client is a build-time-only tool, removed after use.
ARG COSIGN_VERSION=v3.1.3
RUN GOBIN=/tmp/cosign-verify go install github.com/theupdateframework/go-tuf/cmd/tuf-client@v0.7.0 && \
    cd /tmp/cosign-verify && \
    curl -sSfL -o sigstore-root.json \
        https://raw.githubusercontent.com/sigstore/root-signing/refs/heads/main/metadata/root_history/10.root.json && \
    echo "836bff947925edfc23eb9ce17af66fb1e43bb5e2bdd240520985ae52b585eae9  sigstore-root.json" | sha256sum -c - && \
    ./tuf-client init https://tuf-repo-cdn.sigstore.dev sigstore-root.json && \
    ./tuf-client get https://tuf-repo-cdn.sigstore.dev artifact.pub > artifact.pub && \
    curl -sSfL -o cosign-kms.sigstore.json \
        "https://github.com/sigstore/cosign/releases/download/${COSIGN_VERSION}/cosign-linux-${ARCH}-kms.sigstore.json" && \
    jq -r .messageSignature.signature cosign-kms.sigstore.json | base64 -d > cosign-kms.sig.decoded && \
    curl -sSfL -o /usr/local/bin/cosign "https://github.com/sigstore/cosign/releases/download/${COSIGN_VERSION}/cosign-linux-${ARCH}" && \
    openssl dgst -sha256 -verify artifact.pub -signature cosign-kms.sig.decoded /usr/local/bin/cosign && \
    chmod +x /usr/local/bin/cosign && \
    /usr/local/bin/cosign verify-blob --bundle cosign-kms.sigstore.json --key artifact.pub /usr/local/bin/cosign && \
    cd / && rm -rf /tmp/cosign-verify && go clean -cache -modcache

# Link get-subctl script so it can be easily run inside a shell
RUN mkdir -p /root/.local/bin && ln -s $SCRIPTS_DIR/get-subctl.sh /root/.local/bin/subctl

# Copy kubecfg to always run on the shell
COPY scripts/shared/lib/kubecfg /etc/profile.d/kubecfg.sh

# Print kube context on interactive shell
COPY scripts/shared/kubeps1.sh /etc/profile.d/

# Copy shared files so that downstream projects can use them
COPY Makefile.* .gitlint ${SHIPYARD_DIR}/

# Copy the global dapper file so that we can make sure consuming projects are up to date
COPY Dockerfile.dapper ${SHIPYARD_DIR}/

# Copy CI deployment scripts into image to share with all projects
WORKDIR $SCRIPTS_DIR
COPY scripts/shared/ .

# Copy our j2 wrapper for jinja2
COPY package/j2 /usr/local/bin/
